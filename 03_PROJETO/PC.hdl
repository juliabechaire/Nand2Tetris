CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Register(in= final, load= true, out= atual, out = out);
    
    Inc16(in= atual, out= x3);
    Mux16(a= atual, b= x3, sel= inc, out = x1);
    Mux16(a= x1, b= in, sel= load, out= x2);  
    Mux16(a= x2, b= false, sel= reset, out= final);
    
}